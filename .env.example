# Every value here has a working default. Copy to .env only to override.
# With no .env at all the service runs against deterministic simulated pools.

HTTP_ADDR=:8080

# Leave empty to use simulated pool data (no API key needed).
# Set to an Alchemy / Infura / self-hosted endpoint for live mainnet reads.
ETH_RPC_URL=

# Leave empty to run without Redis. Snapshots then live only in process memory.
REDIS_URL=redis://localhost:6379/0

# Bounded concurrency to the RPC provider. Raise only if your plan allows it.
RPC_WORKERS=16
RPC_RATE_PER_SEC=10
RPC_BURST=20

# How often the indexer rebuilds the graph snapshot.
REFRESH_INTERVAL=6s

# Route length cap. 1 to 6.
MAX_HOPS=3

# Makes simulated pool state identical across machines.
SIM_SEED=1337
